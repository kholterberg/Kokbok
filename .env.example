# Kopiera till .env och anpassa. .env följs inte av git, så git pull skriver aldrig över den.

# Port som appen nås på. Byt om 3000 redan används av något annat på servern.
RECIPEHUB_PORT=3000

# Fyll i för att kräva inloggning (HTTP Basic Auth).
# Lämna tomt om du kör bakom en reverse proxy som sköter inloggningen (Authelia, Authentik m.fl.)
AUTH_USER=
AUTH_PASSWORD=
